# Formspree form endpoints
# Create forms at https://formspree.io, then paste each form's endpoint URL below.
# Copy this file to .env.local and fill in the real values before deploying.

VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/YOUR_CONTACT_FORM_ID
VITE_STORY_FORM_ENDPOINT=https://formspree.io/f/YOUR_STORY_FORM_ID

# Server-only (Vercel → Project Settings → Environment Variables, Production).
# Create it under Project Settings → Git → Deploy Hooks (branch: main). Used by api/rebuild.js
# so admin saves rebuild the prerendered pages. Not prefixed with VITE_, so it never reaches the browser.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/YOUR_HOOK
